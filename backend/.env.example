# Models 
WHISPER_MODEL=medium # Speech-to-Text 
OLLAMA_MODEL=gemma3:12b # Large Language Model (LLM)
PIPER_MODEL=en_US-amy-medium # Text-to-Speech (TTS)

# Ollama Endpoint
OLLAMA_HOST=http://localhost:11434

# Whisper Configuration for Speech-to-Text
WHISPER_LANGUAGE=en
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=True
WHISPER_DEVICE=cuda

# LLM Configuration
LLM_LANGUAGE=English
LLM_USER_NAME=UserName
LLM_ASSISTANT_NAME=Lyra
LLM_OS_CONTEXT=Windows

# Server
API_HOST=127.0.0.1
API_PORT=8000